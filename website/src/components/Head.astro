---
// Override of Starlight's <Head>: renders the default tags, then adds the per-page
// OpenGraph image generated by src/pages/og/[...slug].ts. Starlight already emits
// og:title/description/url and twitter:card=summary_large_image — we only add the image.
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const slug = route.id && route.id.length ? route.id : 'index';
const ogImage = new URL(`${import.meta.env.BASE_URL}og/${slug}.png`, Astro.site).href;
---

<Default />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImage} />
